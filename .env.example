# AURA — Environment Variables Template
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to Git.

PORT=5000

# Database (optional — falls back to local JSON if not configured)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aura_db

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3
# Get from: https://console.cloud.google.com → Enable YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# JWT secret (generate a long random string)
JWT_SECRET=your_very_long_random_secret_here
